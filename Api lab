from typing import List, Optional
from pydantic import BaseModel
import requests



class LocationModel(BaseModel):
  name: str
  latitude: float
  longitude: float


class GeocodingResponse(BaseModel):
  results: Optional[List[LocationModel]] = None


class CurrentWeatherModel(BaseModel):
  temperature_2m: float
  apparent_temperature: float
  relative_humidity_2m: float
  wind_speed_10m: float


class ForecastResponse(BaseModel):
  current: CurrentWeatherModel



class CityWeatherReport(BaseModel):
  city_name: str
  temperature_2m: float
  apparent_temperature: float
  relative_humidity_2m: float
  wind_speed_10m: float



class WeatherClient:

  def __init__(
      self,
      geocoding_url: str = 'https://geocoding-api.open-meteo.com/v1/search',
      forecast_url: str = 'https://api.open-meteo.com/v1/forecast',
  ):
    self.geocoding_url = geocoding_url
    self.forecast_url = forecast_url

  def fetch_weather(self, city: str) -> Optional[CityWeatherReport]:
    try:
      geo_params = {'name': city, 'count': 1, 'language': 'ru'}
      geo_response = requests.get(
          self.geocoding_url, params=geo_params, timeout=10
      )
      geo_response.raise_for_status()

      geo_data = GeocodingResponse.model_validate(geo_response.json())
      if not geo_data.results:
        print(f'Координаты для города "{city}" не найдены.')
        return None

      location = geo_data.results[0]

      weather_params = {
          'latitude': location.latitude,
          'longitude': location.longitude,
          'current': (
              'temperature_2m,apparent_temperature,relative_humidity_2m,wind_speed_10m'
          ),
      }
      weather_response = requests.get(
          self.forecast_url, params=weather_params, timeout=10
      )
      weather_response.raise_for_status()

      forecast_data = ForecastResponse.model_validate(weather_response.json())
      current = forecast_data.current

      return CityWeatherReport(
          city_name=location.name,
          temperature_2m=current.temperature_2m,
          apparent_temperature=current.apparent_temperature,
          relative_humidity_2m=current.relative_humidity_2m,
          wind_speed_10m=current.wind_speed_10m,
      )

    except requests.RequestException as req_err:
      print(f'Сетевая ошибка: {req_err}')
      return None
    except Exception as e:
      print(f'Ошибка обработки данных: {e}')
      return None


if __name__ == '__main__':
  client = WeatherClient()
  target_city = input('Введите название города для поиска погоды в нем:\n')

  weather_obj = client.fetch_weather(target_city)

  if weather_obj:
    print(f'Город: {weather_obj.city_name}')
    print(f'Температура: {weather_obj.temperature_2m}°C')
    print(f'Ощущается как: {weather_obj.apparent_temperature}°C')
    print(f'Влажность: {weather_obj.relative_humidity_2m}%')
    print(f'Ветер: {weather_obj.wind_speed_10m} км/ч')

  else:
    print('Не удалось получить данные о погоде.')
